-- ⬜ Snippet 4: Core Logic with True Center-Screen Constraint Circle Radius
local camera = workspace.CurrentCamera
local highlights = {}
local npcHighlights = {}

local function applyHighlight(player, char)
    if not _G.StaringSettings.HighlightEnabled then return end
    
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
    
    if player ~= localPlayer and char then
        local hl = Instance.new("Highlight")
        hl.Adornee = char
        hl.Parent = char
        highlights[player] = hl
        
        if player.Team and player.Team.TeamColor then
            local teamColor = player.Team.TeamColor.Color
            hl.FillColor = teamColor
            hl.OutlineColor = Color3.new(
                math.clamp(teamColor.R + 0.3, 0, 1),
                math.clamp(teamColor.G + 0.3, 0, 1),
                math.clamp(teamColor.B + 0.3, 0, 1)
            )
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        applyHighlight(player, char)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= localPlayer then
        if player.Character then
            applyHighlight(player, player.Character)
        end
        player.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            applyHighlight(player, char)
        end)
    end
end

RunService.RenderStepped:Connect(function(dt)
    -- Handle highlights update (Players & NPCs)
    if not _G.StaringSettings.HighlightEnabled then
        for _, h in pairs(highlights) do h:Destroy() end
        highlights = {}
        for _, h in pairs(npcHighlights) do h:Destroy() end
        npcHighlights = {}
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer and player.Character and not highlights[player] then
                applyHighlight(player, player.Character)
            end
        end
        
        if _G.StaringSettings.CountNPCs then
            local currentNpcs = {}
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj:FindFirstChild("Head") and obj:FindFirstChild("Humanoid") then
                    local isPlayerChar = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character == obj then isPlayerChar = true break end
                    end
                    if not isPlayerChar then
                        currentNpcs[obj] = true
                        if not npcHighlights[obj] then
                            local hl = Instance.new("Highlight")
                            hl.Adornee = obj
                            hl.Parent = obj
                            hl.FillColor = Color3.fromRGB(120, 120, 120)
                            hl.OutlineColor = Color3.fromRGB(220, 220, 220)
                            npcHighlights[obj] = hl
                        end
                    end
                end
            end
            for obj, hl in pairs(npcHighlights) do
                if not currentNpcs[obj] or not obj.Parent then
                    hl:Destroy()
                    npcHighlights[obj] = nil
                end
            end
        else
            for _, h in pairs(npcHighlights) do h:Destroy() end
            npcHighlights = {}
        end
    end
    
    if not _G.StaringSettings.Enabled then return end
    
    local myChar = localPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = myChar.HumanoidRootPart
    
    local bestTarget = nil
    local shortestDist = math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    -- Pure scaling constraint radius: 0% = 0 radius (strict center), 100% = half screen width radius
    local constraintRadius = (_G.StaringSettings.Constraints / 100) * (camera.ViewportSize.X / 2)
    local maxTriggerDist = _G.StaringSettings.TriggerDistance
    
    -- Helper function to evaluate potential targets (Players or NPCs)
    local function evaluateTarget(head, charModel)
        local dist = (head.Position - rootPart.Position).Magnitude
        if dist <= maxTriggerDist then
            local screenPos, onScreen = camera:WorldToScreenPoint(head.Position)
            if onScreen then
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                -- Check if target is inside the center constraint circle radius
                if screenDist <= constraintRadius then
                    
                    local isValid = true
                    if _G.StaringSettings.CountWalls then
                        local raycastParams = RaycastParams.new()
                        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                        raycastParams.FilterDescendantsInstances = {myChar, charModel}
                        local result = workspace:Raycast(camera.CFrame.Position, head.Position - camera.CFrame.Position, raycastParams)
                        if result then
                            isValid = false
                        end
                    end
                    
                    if isValid then
                        local comparisonMetric = _G.StaringSettings.TargetClosest and dist or screenDist
                        if comparisonMetric < shortestDist then
                            shortestDist = comparisonMetric
                            bestTarget = head
                        end
                    end
                end
            end
        end
    end
    
    -- Check Players
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Team and _G.StaringSettings.SelectedTeams[player.Team.Name] then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                evaluateTarget(char.Head, char)
            end
        end
    end
    
    -- Check NPCs if enabled
    if _G.StaringSettings.CountNPCs then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Head") and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                local isPlayerChar = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then isPlayerChar = true break end
                end
                if not isPlayerChar then
                    evaluateTestTarget = evaluateTarget(obj.Head, obj)
                end
            end
        end
    end

    if bestTarget then
        local targetCFrame = CFrame.new(camera.CFrame.Position, bestTarget.Position)
        if _G.StaringSettings.Accuracy <= 0 then
            camera.CFrame = targetCFrame
        else
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(dt / math.max(_G.StaringSettings.Accuracy, 0.01), 0, 1))
        end
    end
end)
