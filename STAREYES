local function refreshTeamList()
	for _, child in ipairs(teamScroller:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local allTeams = Teams:GetTeams()
	for _, team in ipairs(allTeams) do
		local tBtn = Instance.new("TextButton")
		tBtn.Size = UDim2.new(1, 0, 0, 32)
		tBtn.Font = Enum.Font.GothamMedium
		tBtn.Text = team.Name
		tBtn.TextSize = 13
		tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		
		-- Default opposing team selected
		if LocalPlayer.Team and team ~= LocalPlayer.Team and _G.SelectedTeams[team.Name] == nil then
			_G.SelectedTeams[team.Name] = true
		elseif not _G.SelectedTeams[team.Name] then
			_G.SelectedTeams[team.Name] = false
		end
		
		tBtn.BackgroundColor3 = _G.SelectedTeams[team.Name] and Color3.fromRGB(0, 140, 100) or Color3.fromRGB(50, 50, 55)
		tBtn.Parent = teamScroller
		
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = tBtn
		
		tBtn.MouseButton1Click:Connect(function()
			_G.SelectedTeams[team.Name] = not _G.SelectedTeams[team.Name]
			tBtn.BackgroundColor3 = _G.SelectedTeams[team.Name] and Color3.fromRGB(0, 140, 100) or Color3.fromRGB(50, 50, 55)
		end)
	end
	teamScroller.CanvasSize = UDim2.new(0, 0, 0, #allTeams * 38)
end

