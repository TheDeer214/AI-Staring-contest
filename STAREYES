-- Helper function for Sliders with direct numeric input
local function createSlider(name, min, max, step, default, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 65)
    container.BackgroundTransparency = 1
    container.Parent = mainFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 25)
    label.Text = name .. ": " .. default
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundTransparency = 1
    label.Parent = container

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0, 80, 0, 30)
    input.Position = UDim2.new(0.5, -40, 0, 30)
    input.Text = tostring(default)
    input.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.Parent = container

    input.FocusLost:Connect(function()
        local val = tonumber(input.Text)
        if val then
            val = math.clamp(val, min, max)
            input.Text = tostring(val)
            label.Text = name .. ": " .. val
            callback(val)
        else
            input.Text = tostring(default)
        end
    end)
end

createSlider("Accuracy", 0, 1, 0.1, 0, function(val) accuracy = val end)
createSlider("Constraints (%)", 0, 100, 5, 50, function(val) constraints = val / 100 end)

-- ⬜ Snippet 4: Teams Menu & Selection Setup
local teamsFrame = Instance.new("ScrollingFrame")
teamsFrame.Size = mainFrame.Size
teamsFrame.Position = mainFrame.Position
teamsFrame.Visible = false
teamsFrame.CanvasSize = UDim2.new(0, 0, 0, 500)
teamsFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
teamsFrame.BorderSizePixel = 0
teamsFrame.Parent = screenGui

local openTeamsBtn = Instance.new("TextButton")
openTeamsBtn.Size = UDim2.new(1, 0, 0, 45)
openTeamsBtn.Text = "Open Teams"
openTeamsBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
openTeamsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
openTeamsBtn.Parent = mainFrame

local closeTeamsBtn = Instance.new("TextButton")
closeTeamsBtn.Size = UDim2.new(0, 40, 0, 40)
closeTeamsBtn.Position = UDim2.new(1, -45, 0, 5)
closeTeamsBtn.Text = "X"
closeTeamsBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
closeTeamsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeTeamsBtn.Parent = teamsFrame

openTeamsBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
    teamsFrame.Visible = true
    -- Populate teams dynamically
    for _, child in ipairs(teamsFrame:GetChildren()) do
        if child ~= closeTeamsBtn then child:Destroy() end
    end
    
    local yOffset = 50
    for _, team in ipairs(Teams:GetTeams()) do
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, -20, 0, 40)
        tBtn.Position = UDim2.new(0, 10, 0, yOffset)
        tBtn.Text = team.Name
        tBtn.BackgroundColor3 = team.TeamColor.Color
        tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tBtn.Parent = teamsFrame

        -- Default opposing teams selected automatically
        if LocalPlayer.Team ~= team and selectedTeams[team] == nil then
            selectedTeams[team] = true
        end

        tBtn.MouseButton1Click:Connect(function()
            selectedTeams[team] = not selectedTeams[team]
            tBtn.BorderColor3 = selectedTeams[team] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        end)
        yOffset = yOffset + 50
    end
end)

closeTeamsBtn.MouseButton1Click:Connect(function()
    teamsFrame.Visible = false
    mainFrame.Visible = true
end)

-- ⬜ Snippet 5: Main Staring Loop, Constraints, and Highlighting
RunService.RenderStepped:Connect(function(dt)
    -- Handle Highlighting
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if highlightEnabled then
                if not highlights[player] then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = player.Character
                    hl.FillColor = player.Team and player.Team.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                    hl.Parent = player.Character
                    highlights[player] = hl
                end
            else
                if highlights[player] then
                    highlights[player]:Destroy()
                    highlights[player] = nil
                end
            end
        end
    end

    -- Handle Staring Contest
    if not staringEnabled then return end
    
    local closestTarget = nil
    local shortestDist = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local maxScreenRadius = (Camera.ViewportSize.Magnitude / 2) * constraints

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team and selectedTeams[player.Team] then
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                local headPos, onScreen = Camera:WorldToScreenPoint(char.Head.Position)
                if onScreen then
                    local screenPos = Vector2.new(headPos.X, headPos.Y)
                    local distFromCenter = (screenPos - screenCenter).Magnitude
                    if distFromCenter <= maxScreenRadius and distFromCenter < shortestDist then
                        shortestDist = distFromCenter
                        closestTarget = char.Head
                    end
                end
            end
        end
    end

    if closestTarget then
        local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, closestTarget.Position)
        if accuracy > 0 then
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(dt / accuracy, 0, 1))
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local root = LocalPlayer.Character.HumanoidRootPart
                local lookAtFlat = CFrame.new(root.Position, Vector3.new(closestTarget.Position.X, root.Position.Y, closestTarget.Position.Z))
                root.CFrame = root.CFrame:Lerp(lookAtFlat, math.clamp(dt / accuracy, 0, 1))
            end
        else
            Camera.CFrame = targetCFrame
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local root = LocalPlayer.Character.HumanoidRootPart
                root.CFrame = CFrame.new(root.Position, Vector3.new(closestTarget.Position.X, root.Position.Y, closestTarget.Position.Z))
            end
        end
    end
end)
