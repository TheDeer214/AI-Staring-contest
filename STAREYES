-- ⬜ Snippet 5: Target Selection, Raycasting, Constraints, and Staring Loop
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.RenderStepped:Connect(function(dt)
	if not staringEnabled then return end
	
	local char = localPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = char.HumanoidRootPart
	
	local bestTarget = nil
	local closestDist = math.huge
	local screenSize = camera.ViewportSize
	local centerScreen = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
	local maxScreenRadius = (screenSize.Magnitude / 2) * constraints
	
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character and player.Character:FindFirstChild("Head") then
			-- Verify Team selection
			if selectedTeams[player.Team] == true then
				local targetHead = player.Character.Head
				local screenPos, onScreen = camera:WorldToViewportPoint(targetHead.Position)
				
				if onScreen then
					local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
					local distFromCenter = (screenPos2D - centerScreen).Magnitude
					
					-- Check against Constraints percentage
					if distFromCenter <= maxScreenRadius then
						-- Check Wall constraints
						local isValid = true
						if countWalls then
							raycastParams.FilterDescendantsInstances = {char, player.Character}
							local result = Workspace:Raycast(camera.CFrame.Position, targetHead.Position - camera.CFrame.Position, raycastParams)
							if result then
								isValid = false
							end
						end
						
						if isValid and distFromCenter < closestDist then
							closestDist = distFromCenter
							bestTarget = targetHead
						end
					end
				end
			end
		end
	end
	
	if bestTarget then
		local targetCFrame = CFrame.lookAt(camera.CFrame.Position, bestTarget.Position)
		
		if accuracy == 0 then
			camera.CFrame = targetCFrame
			rootPart.CFrame = CFrame.new(rootPart.Position, Vector3.new(bestTarget.Position.X, rootPart.Position.Y, bestTarget.Position.Z))
		else
			-- Accuracy lerp calculation (1 = slower, lower = faster)
			local alpha = math.clamp(dt * (10 / (accuracy * 10 + 0.001)), 0, 1)
			camera.CFrame = camera.CFrame:Lerp(targetCFrame, alpha)
			
			local lookTarget = Vector3.new(bestTarget.Position.X, rootPart.Position.Y, bestTarget.Position.Z)
			rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.new(rootPart.Position, lookTarget), alpha)
		end
	end
end)
