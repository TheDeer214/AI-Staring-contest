-- Helper to initialize default teams (opposing teams auto-selected once)
local function initTeams()
	for _, t in ipairs(game:GetService("Teams"):GetTeams()) do
		if t ~= player.Team then
			selectedTeams[t.Name] = true
		else
			selectedTeams[t.Name] = false
		end
	end
end
