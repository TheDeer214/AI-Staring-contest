-- Highlight System Implementation
local highlightsFolder = workspace:FindFirstChild("StareHighlightsFolder") or Instance.new("Folder")
highlightsFolder.Name = "StareHighlightsFolder"
highlightsFolder.Parent = workspace

local function updateHighlights()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and plr.Character then
			local char = plr.Character
			local hl = highlightsFolder:FindFirstChild(plr.Name)
			if SettingsState.Highlight then
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = plr.Name
					hl.Adornee = char
					hl.Parent = highlightsFolder
				end
				if plr.Team then
					hl.FillColor = plr.Team.TeamColor.Color
					hl.OutlineColor = Color3.new(1, 1, 1)
				end
			else
				if hl then hl:Destroy() end
			end
		end
	end
end

RunService = game:GetService("RunService")
RunService.RenderStepped:Connect(function()
	if SettingsState.Highlight then
		updateHighlights()
	else
		highlightsFolder:ClearAllChildren()
	end
end)

-- ⬜ Snippet 5: Staring Engine
local camera = workspace.CurrentCamera

local function isValidEntity(char)
	if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return false end
	if char.Humanoid.Health <= 0 then return false end
	if char == localPlayer.Character then return false end

	-- Check if player
	local plr = Players:GetPlayerFromCharacter(char)
	if plr then
		if plr.Team and SettingsState.SelectedTeams[plr.Team.Name] then
			return true
		end
		return false
	else
		-- NPC check
		return SettingsState.CountNPCs
	end
end

RunService.RenderStepped:Connect(function()
	if not SettingsState.EnableStare then return end

	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2 + SettingsState.CircleYOffset)
	local radius = SettingsState.StareSensitivity / 2

	local closestEntity = nil
	local closestDist = math.huge

	-- Scan Players & Models in workspace
	local searchPool = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(searchPool, p.Character) end
	end
	if SettingsState.CountNPCs then
		for _, obj in ipairs(workspace:GetChildren()) do
			if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
				table.insert(searchPool, obj)
			end
		end
	end

	for _, char in ipairs(searchPool) do
		if isValidEntity(char) then
			local hrp = char.HumanoidRootPart
			local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
			if onScreen then
				local screenVec2 = Vector2.new(screenPos.X, screenPos.Y)
				local distFromCenter = (screenVec2 - screenCenter).Magnitude
				if distFromCenter <= radius and distFromCenter < closestDist then
					closestDist = distFromCenter
					closestEntity = char
				end
			end
		end
	end

	-- Apply Stare Rotation
	if closestEntity and closestEntity:FindFirstChild("HumanoidRootPart") then
		local hrp = closestEntity.HumanoidRootPart
		local targetCF = CFrame.new(camera.CFrame.Position, hrp.Position)
		
		-- Factor in Stare Strength (0 to 100)
		local alpha = math.clamp(SettingsState.StareStrength / 100, 0, 1)
		if alpha > 0 then
			camera.CFrame = camera.CFrame:Lerp(targetCF, alpha * 0.2)
		end
	end
end)
