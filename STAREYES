-- Helper function to create toggles
local function createToggle(name, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 40)
    frame.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 60, 0, 30)
    btn.Position = UDim2.new(0.8, 0, 0.15, 0)
    btn.Text = default and "ON" or "OFF"
    btn.BackgroundColor3 = default and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = frame
    
    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
        callback(state)
    end)
    frame.Parent = mainFrame
end

createToggle("Enable Staring Contest", settingsData.enableStaring, function(v) settingsData.enableStaring = v end)
createToggle("Highlight all players", settingsData.highlightAll, function(v) settingsData.highlightAll = v end)
createToggle("Count walls", settingsData.countWalls, function(v) settingsData.countWalls = v end)

-- ⬜ Snippet 3: Sliders, Team List View Frame, and Open Teams Button
local function createSlider(name, min, max, step, default, isPercent, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 50)
    frame.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0.5, 0)
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = frame
    
    local inputbox = Instance.new("TextBox")
    inputbox.Size = UDim2.new(0.35, 0, 0.5, 0)
    inputbox.Position = UDim2.new(0.65, 0, 0, 0)
    inputbox.Text = isPercent and (default .. "%") or tostring(default)
    inputbox.TextColor3 = Color3.fromRGB(255, 255, 255)
    inputbox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    inputbox.Parent = frame
    
    inputbox.FocusLost:Connect(function()
        local num = tonumber(inputbox.Text:gsub("%%",""))
        if num then
            num = math.clamp(num, min, max)
            callback(num)
            inputbox.Text = isPercent and (num .. "%") or tostring(num)
        else
            inputbox.Text = isPercent and (default .. "%") or tostring(default)
        end
    end)
    frame.Parent = mainFrame
end

createSlider("Accuracy", 0, 1, 0.1, settingsData.accuracy, false, function(v) settingsData.accuracy = v end)
createSlider("Constraints", 0, 100, 5, settingsData.constraints, true, function(v) settingsData.constraints = v end)

