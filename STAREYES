-- Automatically select all opposing teams at script startup execution
local function initTeams()
    for _, team in ipairs(Teams:GetTeams()) do
        if team ~= localPlayer.Team then
            _G.StaringSettings.SelectedTeams[team.Name] = true
        else
            _G.StaringSettings.SelectedTeams[team.Name] = false
        end
    end
end
initTeams()

local function refreshTeamList()
    for _, child in ipairs(teamsScrolling:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, team in ipairs(Teams:GetTeams()) do
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, 0, 0, 35)
        local isSelected = _G.StaringSettings.SelectedTeams[team.Name] == true
        tBtn.Text = team.Name .. (isSelected and " [Selected]" or " [Deselected]")
        tBtn.BackgroundColor3 = isSelected and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(120, 0, 0)
        tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tBtn.Font = Enum.Font.SourceSansBold
        tBtn.TextSize = 14
        tBtn.Parent = teamsScrolling
        
        tBtn.MouseButton1Click:Connect(function()
            local current = _G.StaringSettings.SelectedTeams[team.Name] == true
            _G.StaringSettings.SelectedTeams[team.Name] = not current
            tBtn.Text = team.Name .. (not current and " [Selected]" or " [Deselected]")
            tBtn.BackgroundColor3 = not current and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(120, 0, 0)
        end)
    end
end

openTeamsBtn.MouseButton1Click:Connect(function()
