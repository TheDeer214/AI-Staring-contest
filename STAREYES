-- ⬜ Snippet 4: Highlight System and Team Management Logic
local Teams = game:GetService("Teams")

-- Initialize opposing teams automatically at execution start
local function initTeams()
	for _, team in ipairs(Teams:GetTeams()) do
		if team ~= localPlayer.Team then
			selectedTeams[team] = true
		else
			selectedTeams[team] = false
		end
	end
end
initTeams()

-- Auto-Highlight Loop for Newcomers / Existing Players
RunService.RenderStepped:Connect(function()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local char = player.Character
			local highlight = highlightsTable[player]
			
			if highlightEnabled then
				if not highlight or highlight.Parent ~= char then
					if highlight then highlight:Destroy() end
					highlight = Instance.new("Highlight")
					highlight.Name = "StaringHighlight"
					highlight.Adornee = char
					highlightsTable[player] = highlight
					highlight.Parent = char
				end
				
				if player.Team then
					highlight.FillColor = player.Team.TeamColor.Color
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				else
					highlight.FillColor = Color3.fromRGB(255, 255, 255)
				end
				highlight.Enabled = true
			else
				if highlight then
					highlight.Enabled = false
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	if highlightsTable[player] then
		highlightsTable[player]:Destroy()
		highlightsTable[player] = nil
	end
end)

