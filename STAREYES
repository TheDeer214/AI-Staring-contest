			end
			
			if player.Team then
				hl.FillColor = player.Team.TeamColor.Color
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			else
				hl.FillColor = Color3.fromRGB(150, 150, 150)
			end
		end
	end
end)

-- Helper: Check if entity is valid target based on teams/NPCs
local function isValidTarget(model)
	if not model or not model:FindFirstChild("HumanoidRootPart") then return false end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	
	-- Check if player
	local player = Players:GetPlayerFromCharacter(model)
	if player then
		if player == LocalPlayer then return false end
		if player.Team and _G.SelectedTeams and _G.SelectedTeams[player.Team.Name] == false then
			return false
		end
		return true
	end
	
	-- Check if NPC
	if _G.CountNPCs then
		return true
	end
	
	return false
end

-- Stare Engine
RunService.RenderStepped:Connect(function()
	if not _G.EnableStare then return end
	
	local sensitivity = _G.StareSensitivity or 300
	local yOffset = _G.CircleYOffset or 0
	local strength = (_G.StareStrength or 75) / 100
	
	local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, (Camera.ViewportSize.Y / 2) + yOffset)
	local radiusSq = (sensitivity / 2) ^ 2
	
	local bestTargetPart = nil
	local closestDistSq = math.huge
	
	-- Scan all potential targets (Players & optional NPCs)
	local candidates = {}
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			table.insert(candidates, p.Character)
		end
	end
	
	if _G.CountNPCs then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
				table.insert(candidates, obj)
			end
		end
	end
	
	for _, char in ipairs(candidates) do
		if isValidTarget(char) then
			local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
			if hrp then
				local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
					local distSq = (screenPos2D - viewportCenter).Magnitude ^ 2
					
					if distSq <= radiusSq and distSq < closestDistSq then
						closestDistSq = distSq
						bestTargetPart = hrp
					end
				end
			end
		end
	end
	
	-- Apply Stare towards best target
	if bestTargetPart then
		local currentCamCF = Camera.CFrame
		local targetCF = CFrame.new(currentCamCF.Position, bestTargetPart.Position)
		Camera.CFrame = currentCamCF:Lerp(targetCF, strength * 0.5)
	end
end)
