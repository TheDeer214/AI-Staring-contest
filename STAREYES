-- Helper to build standard sliders with direct input boxes
local function createSlider(name, min, max, step, defaultVal, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 50)
	container.BackgroundTransparency = 1
	container.Parent = mainFrame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. tostring(defaultVal)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.SourceSans
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = container

	local sliderBar = Instance.new("TextButton")
	sliderBar.Size = UDim2.new(1, -50, 0, 6)
	sliderBar.Position = UDim2.new(0, 0, 0, 30)
	sliderBar.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
	sliderBar.Text = ""
	sliderBar.Parent = container
	Instance.new("UICorner", sliderBar).CornerRadius = UDim.new(1, 0)

	local sliderFill = Instance.new("Frame")
	sliderFill.Size = UDim2.new((defaultVal - min)/(max - min), 0, 1, 0)
	sliderFill.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
	sliderFill.BorderSizePixel = 0
	sliderFill.Parent = sliderBar
	Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

	local inputVal = Instance.new("TextBox")
	inputVal.Size = UDim2.new(0, 40, 0, 24)
	inputVal.Position = UDim2.new(1, -40, 0, 20)
	inputVal.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	inputVal.Text = tostring(defaultVal)
	inputVal.TextColor3 = Color3.fromRGB(255, 255, 255)
	inputVal.TextSize = 12
	inputVal.Parent = container
	Instance.new("UICorner", inputVal).CornerRadius = UDim.new(0, 4)

	local function updateValue(val)
		val = math.clamp(val, min, max)
		if step > 0 then
			val = math.round(val / step) * step
		end
		-- Fix floating point issues
		val = tonumber(string.format("%.2f", val))
		
		sliderFill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
		label.Text = name .. ": " .. tostring(val)
		inputVal.Text = tostring(val)
		callback(val)
	end

	local sliding = false
	sliderBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local pos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
			updateValue(min + (max - min) * pos)
		end
	end)

	inputVal.FocusLost:Connect(function()
		local num = tonumber(inputVal.Text)
		if num then
			updateValue(num)
		else
			inputVal.Text = label.Text:match(": (.*)")
		end
	end)
end

