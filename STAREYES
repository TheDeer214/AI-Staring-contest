-- ⬜ Snippet 4: Team Selection Logic & Highlight All Players Loop
local Teams = game:GetService("Teams")
local selectedTeams = {}

-- Automatically select opposing teams at start
task.spawn(function()
    task.wait(1)
    for _, team in ipairs(Teams:GetTeams()) do
        if team ~= LocalPlayer.Team then
            selectedTeams[team] = true
        end
    end
    
    local tLayout = Instance.new("UIListLayout")
    tLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tLayout.Padding = UDim.new(0, 5)
    tLayout.Parent = teamsFrame
    
    for _, team in ipairs(Teams:GetTeams()) do
        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, -10, 0, 35)
        tBtn.Text = team.Name
        tBtn.BackgroundColor3 = selectedTeams[team] and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(80, 80, 80)
        tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tBtn.Parent = teamsFrame
        
        tBtn.MouseButton1Click:Connect(function()
            selectedTeams[team] = not selectedTeams[team]
            tBtn.BackgroundColor3 = selectedTeams[team] and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(80, 80, 80)
        end)
    end
end)

-- Highlight system
task.spawn(function()
    while true do
        task.wait(1)
        if settingsData.highlightAll then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    if not char:FindFirstChild("StaringHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "StaringHighlight"
                        hl.Adornee = char
                        hl.Parent = char
                    end
                    local hl = char:FindFirstChild("StaringHighlight")
                    if player.Team then
                        hl.FillColor = player.Team.TeamColor.Color
                        hl.OutlineColor = player.Team.TeamColor.Color
                    end
                    hl.Enabled = true
                end
            end
        else
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("StaringHighlight") then
                    player.Character.StaringHighlight.Enabled = false
                end
            end
        end
    end
end)

-- ⬜ Snippet 5: Main Staring Logic (Camera and Character Staring with Raycast & Constraints)
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

RunService.RenderStepped:Connect(function(dt)
    if not settingsData.enableStaring then return end
    
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = myChar.HumanoidRootPart
    
    local bestTarget = nil
    local shortestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local targetTeam = player.Team
            if not targetTeam or selectedTeams[targetTeam] then
                local head = player.Character.Head
                local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
                
                if onScreen then
                    -- Check constraints (screen center closeness based on percentage)
                    local viewportSize = Camera.ViewportSize
                    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    local maxDist = (viewportSize.Magnitude / 2) * (settingsData.constraints / 100)
                    
                    if distFromCenter <= maxDist then
                        -- Check wall obstruction
                        local canSee = true
                        if settingsData.countWalls then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances = {myChar, player.Character}
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            local result = workspace:Raycast(Camera.CFrame.Position, head.Position - Camera.CFrame.Position, rayParams)
                            if result then
                                canSee = false
                            end
                        end
                        
                        if canSee then
                            local dist = (head.Position - rootPart.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                bestTarget = head
                            end
                        end
                    end
                end
            end
        end
    end
    
    if bestTarget then
        local targetCFrame = CFrame.new(Camera.CFrame.Position, bestTarget.Position)
        if settingsData.accuracy == 0 then
            Camera.CFrame = targetCFrame
        else
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(dt / settingsData.accuracy, 0.05, 1))
        end
    end
end)
