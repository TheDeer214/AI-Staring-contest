		if child:IsA("TextButton") then child:Destroy() end
	end
	
	for _, team in ipairs(Teams:GetTeams()) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 32)
		local isSelected = SettingsState.SelectedTeams[team.Name] or false
		btn.BackgroundColor3 = isSelected and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(45, 45, 45)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = team.Name
		btn.TextSize = 14
		btn.Font = Enum.Font.Gotham
		btn.Parent = teamScroll
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			SettingsState.SelectedTeams[team.Name] = not SettingsState.SelectedTeams[team.Name]
			btn.BackgroundColor3 = SettingsState.SelectedTeams[team.Name] and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(45, 45, 45)
		end)
	end
	teamScroll.CanvasSize = UDim2.new(0, 0, 0, teamListLayout.AbsoluteContentSize.Y)
end

