-- ⬜ Snippet 4: Automated Highlighting, Wall-checking, and Camera/Character Staring Loop
local camera = workspace.CurrentCamera

RunService.RenderStepped:Connect(function(dt)
	-- Manage Highlights Automatically for all players (including newcomers)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local char = p.Character
			local highlight = char:FindFirstChild("StaringHighlight")
			if config.HighlightEnabled then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "StaringHighlight"
					highlight.Adornee = char
					highlight.Parent = char
				end
				if p.Team then
					highlight.FillColor = p.Team.TeamColor.Color
					highlight.OutlineColor = p.Team.TeamColor.Color
				end
			else
				if highlight then highlight:Destroy() end
			end
		end
	end

	-- Staring logic execution
	if not config.StaringEnabled then return end
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = char.HumanoidRootPart

	local bestTarget = nil
	local shortestDist = math.huge
	local viewportSize = camera.ViewportSize

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Team and selectedTeams[p.Team.Name] and p.Character and p.Character:FindFirstChild("Head") then
			local targetHead = p.Character.Head
			local screenPos, onScreen = camera:WorldToViewportPoint(targetHead.Position)
			
			if onScreen then
				-- Apply constraints check (screen center proximity based on percentage)
				local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
				local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
				local maxAllowedDist = (viewportSize.Magnitude / 2) * (config.Constraints / 100)
				
				if config.Constraints == 100 or distFromCenter <= maxAllowedDist then
					-- Check walls if enabled
					local isValid = true
					if config.CountWalls then
						local rayParams = RaycastParams.new()
						rayParams.FilterDescendantsInstances = {char, p.Character}
						rayParams.FilterType = Enum.RaycastFilterType.Blacklist
						local result = workspace:Raycast(camera.CFrame.Position, targetHead.Position - camera.CFrame.Position, rayParams)
						if result then isValid = false end
					end
					
					if isValid then
						local dist = (targetHead.Position - rootPart.Position).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							bestTarget = targetHead
						end
					end
				end
			end
		end
	end

	-- Lock camera and character onto best target if found
	if bestTarget then
		local targetCFrame = CFrame.new(camera.CFrame.Position, bestTarget.Position)
		if config.Accuracy > 0 then
			camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(dt / config.Accuracy, 0, 1))
		else
			camera.CFrame = targetCFrame
		end
		
		-- Look at target with character root part smoothly
		local lookVector = Vector3.new(bestTarget.Position.X, rootPart.Position.Y, bestTarget.Position.Z)
		rootPart.CFrame = CFrame.new(rootPart.Position, lookVector)
	end
end)
